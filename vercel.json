{
  "buildCommand": "cd demo/v1 && npm install && npm run build",
  "outputDirectory": "demo/v1/dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/cleanup-old-letters", "schedule": "0 18 * * *" },
    { "path": "/api/check-no-response", "schedule": "0 12 * * *" }
  ]
}
